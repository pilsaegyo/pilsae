{
  "name": "pilsae",
  "main": "site-gate.js",
  "compatibility_date": "2026-10-20",
  "workers_dev": true,
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "services": [
    {
      "binding": "PILSAE_ADMIN_API",
      "service": "pilsae-admin-api"
    }
  ]
}
